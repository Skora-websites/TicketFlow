# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/ticketing

# NextAuth session secret. Generate a strong value:
#   openssl rand -base64 32
AUTH_SECRET=replace-with-a-long-random-secret

# Public base URL (used for auth callbacks and email links)
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Required for `next start` (production): Auth.js v5 rejects untrusted hosts
# outside dev mode. Set true unless you configure a trusted proxy instead.
AUTH_TRUST_HOST=true

# --- OAuth providers (optional) ---
# The sign-in buttons appear automatically once these are set.
# Google: https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# GitHub: https://github.com/settings/developers
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# --- SMTP (optional) ---
# Without SMTP_HOST, password-reset emails cannot be delivered; in development
# the reset link is returned by the API instead. Required in production.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Helpdesk <no-reply@example.com>

# --- Seed script (optional) ---
# Password assigned to demo users created by `npm run seed`.
# Defaults to the documented demo password below; set this to customize it.
SEED_DEMO_PASSWORD=wBDWlqZk9uLIA1!
